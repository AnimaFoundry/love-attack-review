{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Copyright 2026 AnimaFoundry. MIT; see LICENSE-CODE. Decoded-value shape only; contracts.py additionally enforces exact bytes, UTF-8, no BOM, byte limit, unique JSON members, Unicode scalar validity and lexical integers. The source-aware gate separately checks facts and pointers. No runtime/model compatibility has been tested.",
  "title": "BF-01C evidence-bearing response shape",
  "type": "object",
  "additionalProperties": false,
  "required": ["state", "value", "evidence"],
  "properties": {
    "state": {"enum": ["observed", "unknown", "absent"]},
    "value": {"type": ["integer", "null"], "minimum": -2147483648, "maximum": 2147483647},
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document_id", "revision", "sha256", "key", "row"],
      "properties": {
        "document_id": {"type": "string", "minLength": 1, "maxLength": 80},
        "revision": {"type": "integer", "minimum": 1},
        "sha256": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}$"},
        "key": {"type": "string", "minLength": 1, "maxLength": 80},
        "row": {"type": ["integer", "null"], "minimum": 0, "maximum": 63}
      }
    }
  },
  "oneOf": [
    {
      "properties": {
        "state": {"const": "observed"},
        "value": {"type": "integer"},
        "evidence": {"properties": {"row": {"type": "integer"}}}
      }
    },
    {
      "properties": {
        "state": {"const": "unknown"},
        "value": {"type": "null"},
        "evidence": {"properties": {"row": {"type": "integer"}}}
      }
    },
    {
      "properties": {
        "state": {"const": "absent"},
        "value": {"type": "null"},
        "evidence": {"properties": {"row": {"type": "null"}}}
      }
    }
  ]
}
